# API
#
# DATABASE_URL is the application connection. It MUST use the restricted
# `permitflow_app` role: PostgreSQL Row Level Security is enforced per table and
# a superuser bypasses it, which would silently disable tenant isolation.
# Create/refresh that role with: python api/bootstrap_role.py
DATABASE_URL=postgresql+psycopg://permitflow_app:replace-with-app-db-password@localhost:5432/postgres

# Privileged connection, used only by `alembic upgrade head` and `api/seed.py`.
# The app role cannot write rows outside its own tenant by design, so migrations
# and seeding must run as the schema owner. Never use this from app code.
DATABASE_URL_ADMIN=postgresql+psycopg://USER:PASSWORD@localhost:5432/permitflow

# Password applied to permitflow_app by bootstrap_role.py. Keep it out of git.
APP_DB_PASSWORD=replace-with-app-db-password

# JWT. Generate a real secret, never commit it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Seeded demo accounts (Springfield and Riverton) all share this password.
# Demo data only — never reuse a real password here.
DEMO_USER_PASSWORD=Demo1234!

# Web
# NOTE: Next.js only reads env files from the web/ directory, so these live in
# web/.env.local rather than here. Do not expose secrets via NEXT_PUBLIC_* vars.
NEXT_PUBLIC_API_URL=http://localhost:8000
